{
  "name": "runqora",
  "version": "0.1.0",
  "description": "Runqora for your server: verify API keys, send and receive webhooks, report cron heartbeats, and connect your users through Better Auth or any auth system.",
  "keywords": [
    "runqora",
    "api-keys",
    "webhooks",
    "cron",
    "monitoring",
    "auth",
    "better-auth",
    "better-auth-plugin"
  ],
  "homepage": "https://runqora.dev",
  "bugs": {
    "url": "https://github.com/amblydia/runqora-js/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amblydia/runqora-js.git"
  },
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./auth": {
      "types": "./dist/auth.d.ts",
      "import": "./dist/auth.js"
    },
    "./better-auth": {
      "types": "./dist/better-auth.d.ts",
      "import": "./dist/better-auth.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun scripts/build.ts",
    "check": "ultracite check && tsc --noEmit",
    "fix": "ultracite fix",
    "prepublishOnly": "bun run check && bun run test && bun run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/bun": "^1.3.6",
    "better-auth": "1.7.7",
    "tsdown": "0.23.0",
    "typescript": "^5.9.0",
    "ultracite": "7.12.2",
    "vitest": "^5.0.4"
  },
  "peerDependencies": {
    "better-auth": "^1.6.13"
  },
  "peerDependenciesMeta": {
    "better-auth": {
      "optional": true
    }
  },
  "packageManager": "bun@1.3.6",
  "engines": {
    "node": ">=20"
  }
}
